{
  "name": "sprintflow",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run worker:dev\" \"npm run frontend:dev\"",
    "frontend:dev": "vite --port 3000 --host 0.0.0.0",
    "worker:dev": "wrangler dev worker/index.ts --port 8787 --local",
    "worker:deploy": "wrangler deploy",
    "db:create": "wrangler d1 create sprintflow-db",
    "db:migrate": "wrangler d1 migrations apply sprintflow-db",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@clerk/clerk-react": "^4.30.0",
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "posthog-js": "^1.258.6",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "stripe": "^14.9.0",
    "svix": "^1.24.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "wrangler": "^3.0.0"
  }
}
