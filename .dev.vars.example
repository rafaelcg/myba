# Local Worker secrets for `npm run worker:dev` (copy to .dev.vars).
BETTER_AUTH_SECRET=<any random 32+ char string>
# Origin the SPA runs on; vite proxies /api to the worker.
BETTER_AUTH_URL=http://localhost:3000
# Optional: Google OAuth client (needed for "Continue with Google").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
